{
  "manifest_version": 3,
  "name": "Orbit Agent Browser Connector",
  "version": "1.0.0",
  "description": "Connect your Chrome browser to Orbit Agent for AI-powered automation",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}